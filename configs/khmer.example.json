{
  "telegramBotToken": "여기에_텔레그램_봇_토큰",
  "openaiApiKey": "여기에_OPENAI_API_KEY",
  "geminiApiKey": "여기에_GEMINI_API_KEY",

  "targetLanguage": "Korean",
  "model": "gemini-2.5-flash",
  "fallbackModel": "gpt-5.2",

  "allowedChatIds": [],
  "autoTranslate": true,
  "koreanTo": "Khmer",
  "khmerTo": "Korean",

  "telegram": {
    "mode": "webhook",
    "proxyUrl": null,
    "webhook": {
      "publicUrl": "https://YOUR_PUBLIC_HTTPS_URL",
      "path": "/telegram-webhook",
      "host": "0.0.0.0",
      "port": 64000,
      "certPath": "/etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem",
      "keyPath": "/etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem"
    }
  },

  "maxInputChars": 2500,
  "systemPrompt": "You are a translator. Translate into the requested target language. Preserve line breaks and emojis. Output only the translation.",

  "promptRegisterKoreanToKhmer": "듣는 사람은 여자 연인이다. 연인 말투로 자연스러운 크메르어로 번역한다.",
  "promptRegisterKhmerToKorean": "듣는 사람은 남자 연인이다. 남자에게 하는 연인 말투로 자연스러운 한국어로 번역한다."
}

